PROJECT_NAME=AI Agent Space
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
DATABASE_URL=sqlite:///./sql_app.db
OPENAI_API_KEY=sk-your-key-here
GEMINI_API_KEY=....
CORS_ORIGINS=*
# For production frontend on Vercel, specify:
# CORS_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:3000
OPENAI_BASE_URL=

# --- Sandbox execution (Phase 3) ---
SANDBOX_MODE=auto
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_NANO_CPUS=1000000000
SANDBOX_NETWORK_ENABLED=false
SANDBOX_KEEP_WORKSPACES=false
