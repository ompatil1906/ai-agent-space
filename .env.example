# AI Agent Space Environment Variables
# Copy this file to .env and fill in the values

# Backend
SECRET_KEY=your-super-secret-key-change-this-in-production
DATABASE_URL=sqlite:///./sql_app.db
# For PostgreSQL: postgresql://user:password@localhost:5432/aiagentspace

# LLM Providers (at least one required for agents)
OPENAI_API_KEY=
OPENAI_BASE_URL=  # Optional: for local models like Ollama (http://localhost:11434/v1)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Sandbox
SANDBOX_MODE=auto
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m

# Frontend (for Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
